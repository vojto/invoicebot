<table cellpadding="6" style="border-collapse: collapse;">
  <tr>
    <th align="left" style="border-bottom: 1px solid #ccc;">Month</th>
    <th align="left" style="border-bottom: 1px solid #ccc;">Vendor</th>
    <th align="right" style="border-bottom: 1px solid #ccc;">Amount</th>
  </tr>
  <% @invoices.each do |invoice| %>
    <tr>
      <td><%= invoice.accounting_date.strftime("%B %Y") %></td>
      <td><%= invoice.vendor_name %></td>
      <td align="right"><%= number_to_currency(share_amount_cents(invoice).to_f / 100, unit: invoice.currency, format: "%n %u") %></td>
    </tr>
  <% end %>
</table>
